{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darwin-bitget",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRADER_AGENT",
        "class_name": "TraderAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TraderAgent"]
    }
  ],
  "vars": {
    "TRADING_MODE": "PAPER",
    "AGENT_MODE": "AUTONOMOUS",
    "PAPER_ONLY": "true",
    "BITGET_CATEGORY": "USDT-FUTURES",
    "MAX_SINGLE_POSITION_MARGIN_PCT": "30",
    "MAX_LEVERAGE": "5",
    "MAX_DAILY_DRAWDOWN_PCT": "10",
    "DRAWDOWN_COOLDOWN_MINUTES": "60",
    "SCAN_INTERVAL_MINUTES": "15",
    "EMERGENCY_STOP": "false",
    "EVIDENCE_MAX_AGE_SECONDS": "90",
    "QWEN_BASE_URL": "https://hackathon.bitgetops.com/v1",
    "QWEN_MODEL": "qwen3.8-max",
    "EVA_API_URL": "https://api.evalabs.my.id",
    "EVA_GATEWAY_URL": "wss://api.evalabs.my.id/v1/agent/connect",
    "EVA_AGENT_ID": "agt_MoFh0GlqzkobuQdg",
    "APP_VERSION": "0.2.0",
    "GIT_COMMIT_SHA": "1a0b8c7",
    "ENVIRONMENT": "production",
  }
}
